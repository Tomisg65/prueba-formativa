---
import Layout from "../layouts/layout.astro";
---

<Layout title="Tyler, The Creator">
    <section class="artist-hero">
        <h1>Tyler, The Creator</h1>
        <p>
            Tyler Gregory Okonma es un rapero, productor, director y diseñador
            estadounidense. Co-fundó el colectivo de música Odd Future y ha
            evolucionado desde el rap oscuro hasta producciones melódicas y
            conceptuales galardonadas con el Grammy.
        </p>
    </section>

    <h2>Álbumes Destacados</h2>
    <div class="albums-grid">
        <div class="album-card">
            <h3>IGOR</h3>
            <p>2019</p>
        </div>
        <div class="album-card">
            <h3>CALL ME IF YOU GET LOST</h3>
            <p>2021</p>
        </div>
        <div class="album-card">
            <h3>Flower Boy</h3>
            <p>2017</p>
        </div>
    </div>
</Layout>
