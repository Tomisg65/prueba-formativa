---
import Layout from "../layouts/layout.astro";
---

<Layout title="Kendrick Lamar">
    <section class="artist-hero">
        <h1>Kendrick Lamar</h1>
        <p>
            Kendrick Lamar Duckworth es considerado uno de los líricos más
            importantes de todos los tiempos. Conocido por sus álbumes
            conceptuales que abordan temas sociales, raciales y de superación
            personal.
        </p>
    </section>

    <h2>Álbumes Destacados</h2>
    <div class="albums-grid">
        <div class="album-card">
            <h3>To Pimp a Butterfly</h3>
            <p>2015</p>
        </div>
        <div class="album-card">
            <h3>good kid, m.A.A.d city</h3>
            <p>2012</p>
        </div>
        <div class="album-card">
            <h3>DAMN.</h3>
            <p>2017</p>
        </div>
    </div>
</Layout>
