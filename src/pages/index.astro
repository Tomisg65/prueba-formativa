---
import Layout from "../layouts/layout.astro";
import Button from "../components/button.astro";
---

<Layout title="Inicio">
	<section class="hero">
		<h1>Iconos del Hip-Hop Moderno</h1>
		<p>
			Explora la trayectoria y discografía de cuatro de los artistas más
			influyentes de la última década.
		</p>
	</section>

	<div class="artists-grid">
		<div class="card">
			<h2>Tyler, The Creator</h2>
			<p>Productor, rapero y diseñador de moda revolucionario.</p>
			<Button href="/tyler">Ver perfil</Button>
		</div>
		<div class="card">
			<h2>Kendrick Lamar</h2>
			<p>Ganador de 27 grammys y lírico excepcional.</p>
			<Button href="/kendrick">Ver perfil</Button>
		</div>
		<div class="card">
			<h2>Kanye West</h2>
			<p>Pionero de la producción, Genio creativo y figura clave en la música.</p>
			<Button href="/kanye">Ver perfil</Button>
		</div>
		<div class="card">
			<h2>Frank Ocean</h2>
			<p>Maestro de la narrativa y voz única del R&B alternativo.</p>
			<Button href="/frank">Ver perfil</Button>
		</div>
	</div>
</Layout>

<style>
	.hero {
		text-align: center;
		margin-bottom: 3rem;
	}
	.artists-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1.5rem;
	}
	.card {
		background-color: var(--card-bg);
		padding: 1.5rem;
		border-radius: 8px;
		border: 1px solid #333;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1rem;
	}
</style>
