---
import Layout from "../layouts/layout.astro";
import Button from "../components/button.astro";
---

<Layout title="Inicio">
	<section class="hero-home">
		<h1>Las 4 Mentes Maestras del Hip-Hop</h1>
		<p>
			Explora la biografía, mayores reconocimientos, récords mundiales e
			hitos históricos de cuatro de los artistas más dominantes de nuestra
			era.
		</p>
	</section>

	<div class="artists-grid">
		<div class="card">
			<div class="card-header">
				<h3>Tyler, The Creator</h3>
				<span class="genre-tag">Alternative Hip-Hop</span>
			</div>
			<p>
				Productor visionario, ganador de 2 Grammys y fundador de la
				marca Golf Wang.
			</p>
			<Button href="/tyler">Ver Logros & Biografía</Button>
		</div>

		<div class="card">
			<div class="card-header">
				<h3>Kendrick Lamar</h3>
				<span class="genre-tag">Conscious Rap</span>
			</div>
			<p>
				Primer rapero en ganar un Premio Pulitzer de Música y poseedor
				de múltiples Grammys.
			</p>
			<Button href="/kendrick">Ver Logros & Biografía</Button>
		</div>

		<div class="card">
			<div class="card-header">
				<h3>Kanye West</h3>
				<span class="genre-tag">Hip-Hop / Industrial</span>
			</div>
			<p>
				Pionero del sonido moderno con más de 24 Premios Grammy en su
				trayectoria.
			</p>
			<Button href="/kanye">Ver Logros & Biografía</Button>
		</div>

		<div class="card">
			<div class="card-header">
				<h3>Drake</h3>
				<span class="genre-tag">Melodic Rap / R&B</span>
			</div>
			<p>
				El artista con más éxitos en la historia del Billboard Hot 100 y
				dominador comercial global.
			</p>
			<Button href="/drake">Ver Logros & Biografía</Button>
		</div>
	</div>
</Layout>

<style>
	.hero-home {
		text-align: center;
		margin-bottom: 3.5rem;
		padding: 3rem 1rem;
	}

	.hero-home h1 {
		font-size: 2.8rem;
		margin-bottom: 1rem;
	}

	.hero-home p {
		font-size: 1.2rem;
		max-width: 700px;
		margin: 0 auto;
	}

	.artists-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.5rem;
	}

	.card {
		background-color: var(--card-bg);
		border: 1px solid var(--card-border);
		border-radius: 16px;
		padding: 1.75rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1.25rem;
	}

	.genre-tag {
		display: inline-block;
		font-size: 0.75rem;
		background-color: rgba(229, 9, 20, 0.15);
		color: var(--accent-color);
		padding: 0.2rem 0.6rem;
		border-radius: 20px;
		font-weight: 600;
		margin-top: 0.2rem;
	}
</style>
