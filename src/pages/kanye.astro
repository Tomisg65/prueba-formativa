---
import Layout from "../layouts/layout.astro";
---

<Layout title="Kanye West">
    <section class="artist-hero">
        <h1>Kanye West (Ye)</h1>
        <p>
            Kanye Omari West es un rapero, productor y diseñador de moda. Ha
            influido enormemente en la evolución del hip-hop moderno gracias a
            sus constantes innovaciones sonoras.
        </p>
    </section>

    <h2>Álbumes Destacados</h2>
    <div class="albums-grid">
        <div class="album-card">
            <h3>My Beautiful Dark Twisted Fantasy</h3>
            <p>2010</p>
        </div>
        <div class="album-card">
            <h3>The College Dropout</h3>
            <p>2004</p>
        </div>
        <div class="album-card">
            <h3>Yeezus</h3>
            <p>2013</p>
        </div>
    </div>
</Layout>
