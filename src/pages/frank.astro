---
import Layout from "../layouts/layout.astro";
---

<Layout title="Frank Ocean">
    <section class="artist-hero">
        <h1>Frank Ocean</h1>
        <p>
            Christopher Francis Ocean es un cantautor y rapero conocido por su
            estilo vanguardista, letras introspectivas y su impacto crucial en
            el género del R&B alternativo.
        </p>
    </section>

    <h2>Álbumes Destacados</h2>
    <div class="albums-grid">
        <div class="album-card">
            <h3>Blonde</h3>
            <p>2016</p>
        </div>
        <div class="album-card">
            <h3>Channel Orange</h3>
            <p>2012</p>
        </div>
        <div class="album-card">
            <h3>Endless</h3>
            <p>2016</p>
        </div>
    </div>
</Layout>
